# URL du serveur backend (Railway en prod, localhost en dev).
#
# IMPORTANT — pour tester sur ton iPhone via Expo Go, "localhost" ne marche pas :
# le téléphone n'a pas accès à ton Mac sous ce nom. Utilise l'IP LAN de ton Mac.
#
# Pour la trouver :
#   - macOS : System Settings → Wi-Fi → Details → IP Address (typiquement 192.168.x.x)
#   - ou en ligne de commande : ipconfig getifaddr en0
#
# Exemples :
#   EXPO_PUBLIC_API_URL=http://localhost:3000          # web seulement
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:3000       # iPhone via Expo Go
#   EXPO_PUBLIC_API_URL=https://gjize.up.railway.app   # prod

EXPO_PUBLIC_API_URL=http://localhost:3000
