{
  "expo": {
    "name": "Gjize",
    "slug": "gjize",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "gjize",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gjize.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gjize.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5c0d4118-3865-4789-9844-41d40e1d4de5"
      }
    },
    "owner": "majmun"
  }
}
